# Leave all of these EMPTY for local development and for single-server production
# (Express serves the built client, so API and client share one origin).

# Full API origin, ONLY if the API lives on a different domain than the client, e.g. https://api.example.com
VITE_API_URL=
# Socket.IO origin, ONLY if it differs from VITE_API_URL
VITE_SOCKET_URL=
# Dev proxy target (defaults to http://localhost:5000). Change it if your API runs on another port.
VITE_PROXY_TARGET=
